---
import { absoluteUrl, appUrl } from '../lib/site.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = 'AI mathematics, explained. Honest trust labels, plain words.', ogImage = '/og/home.png' } = Astro.props;
const base = appUrl('/');
const font = (w: number) => `${base}fonts/schibsted-grotesk-${w}.woff2`;
const ogAbsolute = absoluteUrl(ogImage);
const rss = appUrl('/feed.xml');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — Closed Form</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Closed Form`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Closed Form`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbsolute} />
    <link rel="alternate" type="application/rss+xml" title="Closed Form — newly explained entries" href={rss} />
    <link rel="preload" href={font(400)} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font(500)} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font(600)} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
