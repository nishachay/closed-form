---
import { absoluteUrl, appUrl } from '../lib/site.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/closed-form.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: 'archive' | 'about';
}
const { title, description = 'AI mathematics, explained. Honest trust labels, plain words.', ogImage = '/og/home.png', current } = Astro.props;
const rss = appUrl('/feed.xml');
const ogAbsolute = absoluteUrl(ogImage);
const favicon = 'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 10%22><rect x=%222%22 y=%222%22 width=%226%22 height=%226%22 fill=%22%23cd391b%22/></svg>';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — Closed Form</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Closed Form`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Closed Form`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbsolute} />
    <link rel="alternate" type="application/rss+xml" title="Closed Form — newly explained entries" href={rss} />
    <link rel="icon" href={favicon} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
