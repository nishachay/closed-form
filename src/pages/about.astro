---
import Base from '../layouts/Base.astro';
import { appUrl } from '../lib/site.js';
import { TRUST_LADDER } from '../lib/trust.js';

const reportError = 'https://github.com/nishachay/closed-form/issues/new';

const TRUST_BLURBS: Record<string, string> = {
  formal: 'At least one paper in the family is listed in the Lean formalization catalogue.',
  partial: 'No listed formal proof, but the family has Lean notes.',
  claimed: 'Neither — the claim has not been machine-checked.',
};
---
<Base title="About" description="Why Closed Form exists, what the trust labels mean, and how entries are made." current="about">
  <div class="wrap">
    <div class="entry-wrap" style="grid-template-columns:minmax(0,1fr)">
      <article class="entry">
        <div class="label">About</div>
        <h1>Why Closed Form exists</h1>

        <p>
          AI systems now produce mathematics faster than anyone can read it. The papers are written
          for specialists, while the public sees only headlines. Closed Form is a calm public archive
          that turns each result into a page a curious adult can read in three minutes: what it
          claims, how sure we can be, where the question came from, and what changes if it is true.
        </p>

        <h2>The trust labels</h2>
        <p>
          Every entry carries a trust label, computed from the source data — never written by AI,
          never hidden, never softened.
        </p>
        <dl class="tl">
          {TRUST_LADDER.map((t) => (
            <>
              <dt><i class={`dot c-${t.key}`} aria-hidden="true"></i>{t.label}</dt>
              <dd>{TRUST_BLURBS[t.key]}</dd>
            </>
          ))}
        </dl>
        <p>
          “Formal proof listed” means the repository lists a formalization — not that it compiles,
          and not that the Lean statement matches the paper. That is why the label says{' '}
          <em>listed</em>, not <em>verified</em>.
        </p>

        <h2>Review status</h2>
        <ul>
          <li>Sample entry, written by hand</li>
          <li>AI draft — not checked yet (never published)</li>
          <li>Checked by AI against the paper — not yet reviewed by a person</li>
          <li>Reviewed by a person, with a name and date</li>
        </ul>
        <p>
          Any entry not marked reviewed carries the notice: “This entry has not been reviewed by a
          person yet.” An AI never marks an entry reviewed — only a person does.
        </p>

        <h2>How entries are made</h2>
        <p>
          A deterministic ingest reads the source manuscripts and builds the catalogue. A reader
          model drafts each explainer from the paper itself; a second model checks every factual
          claim against the source and deletes what it cannot support. Validation enforces the
          writing rules, and a person reviews before any entry counts as reviewed.
        </p>

        <h2>What we don’t do</h2>
        <p>
          No proof sketches. No hype. No calling a result true because a company published it. No
          impact the paper doesn’t support. The original papers are always one click away — the
          explainer is a translation, not a replacement.
        </p>

        <h2>Report an error</h2>
        <p>
          Found a mistake? <a href={reportError}>Report an error on GitHub</a> — it is the cheapest
          form of human review.
        </p>

        <h2>Credits and license</h2>
        <p>
          Our explanations are published under CC BY 4.0. Source papers come from openai/math
          (Apache-2.0) and remain under their own license. Closed Form is not affiliated with
          OpenAI.
        </p>

        <h2>Public data</h2>
        <p>
          Everything explained on this site is available as JSON, newest first in{' '}
          <a href={appUrl('/feed.xml')}>the RSS feed</a>. Our text is CC BY 4.0; the source papers
          remain Apache-2.0.
        </p>
        <ul>
          <li>
            <a href={appUrl('/data/catalog.json')}>catalog.json</a> — all 372 result families with
            papers, subjects and trust labels (source papers Apache-2.0).
          </li>
          <li>
            <a href={appUrl('/data/entries.json')}>entries.json</a> — every explained entry in
            full, including <code>collection</code>, <code>lab</code>, <code>science</code>,{' '}
            <code>field</code>, <code>aiRole</code> and <code>evidence[]</code>.
          </li>
          <li>
            <a href={appUrl('/data/fields.json')}>fields.json</a> — the 17 fields with{' '}
            <code>collection</code>, <code>lab</code>, <code>science</code>, result and paper
            counts, and the trust split.
          </li>
        </ul>
      </article>
    </div>
  </div>
</Base>
