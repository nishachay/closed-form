---
import { clip, toPlain } from '../../lib/plain.js';
import { formatLongDay } from '../../lib/dates.js';
import Base from '../../layouts/Base.astro';
import Scorecard from '../../components/Scorecard.astro';
import RecordChart from '../../components/RecordChart.astro';
import Notice from '../../components/Notice.astro';
import Glossary from '../../components/Glossary.astro';
import OriginalPapers from '../../components/OriginalPapers.astro';
import TrustLabel from '../../components/TrustLabel.astro';
import { absoluteUrl, appUrl, catalog, entryUrl, familiesById, fieldUrl, loadExplained, neighbors } from '../../lib/site.js';
import { globalIdFor, parseGlobalId } from '../../lib/ids.js';
import { renderMath, renderQuote } from '../../lib/katex.js';
import { citationOrder, renderCitations } from '../../lib/cite.js';

export async function getStaticPaths() {
  return catalog.families.map((f) => ({
    params: { gid: globalIdFor(catalog.collection, f.id) },
  }));
}

const { gid } = Astro.params;
const parsed = parseGlobalId(gid ?? '');
const family = parsed ? familiesById.get(parsed.id) : undefined;
if (!family) throw new Error(`Unknown entry: ${gid}`);

const explained = await loadExplained();
const entry = explained.get(family.id) ?? null;
const { prev, next } = neighbors(family.id);

const reviewNote =
  entry && entry.status !== 'reviewed' ? 'Drafted by one AI model and checked sentence by sentence against the paper by a different one. Spot a mistake? Report an error.' : null;

const shareText = entry
  ? `${entry.scorecard.firstStep ? `Open since ${entry.scorecard.firstStep}. ` : ''}${entry.headline} ∎ ${absoluteUrl(entryUrl(family))}`
  : `${toPlain(family.title)} ∎ ${absoluteUrl(entryUrl(family))}`;
const shareHref = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}`;
const reportHref =
  `https://github.com/nishachay/closed-form/issues/new?template=report-error.yml` +
  `&labels=entry-error&title=${encodeURIComponent(`[entry ${family.id}] `)}`;

/** Prose body (entry.explanation): paragraphs split on blank lines. Replaces the four sections. */
const paragraphs = entry?.explanation
  ? entry.explanation.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
  : [];
const sections = entry?.explanation ? [] : (entry?.sections ?? []);
/** Inline citations: [n] in the explanation → a raised numeral, numbered in reading order. */
const citeOrder = citationOrder(paragraphs);
const citeSeen = new Set<number>();
const paragraphHtml = paragraphs.map((p) => renderCitations(p, citeOrder, renderMath, citeSeen));
const paperName = (c: { paper?: number; sourceId?: number }) => {
  // Which paper the line is quoted from: the claim's `paper` index, the only paper, or a
  // sourceId that points at one of this result's papers. Never an outside work it discusses.
  const viaSource = c.sourceId ? entry?.sources.find((x) => x.id === c.sourceId)?.url : undefined;
  const p = c.paper
    ? family.papers[c.paper - 1]
    : family.papers.length === 1
      ? family.papers[0]
      : family.papers.find((x) => viaSource && viaSource === x.pdf);
  return p ? { name: toPlain(p.title), href: p.pdf } : { name: 'The paper', href: undefined };
};
const cited = [...citeOrder.entries()]
  .sort((a, b) => a[1] - b[1])
  .map(([claimNo, n]) => {
    const c = entry!.claims![claimNo - 1];
    // The full sentence(s) from the paper when we have them; the single LaTeX line otherwise.
    return { n, quote: c.sourceQuote ?? c.sourceLine ?? '', paper: paperName(c) };
  });
const aiSection = (entry?.sections ?? []).find((s) => s.title === 'What it says about AI') ?? null;
const title = `${family.id} · ${toPlain(family.title)}`;
/** Source citations: strip the internal † "check me" marker and link arXiv ids. */
const cleanCite = (cite: string) => {
  const unchecked = /†\s*$/.test(cite);
  const text = cite.replace(/\s*†\s*$/, '');
  const arxiv = /arXiv:(\d{4}\.\d{4,5})/.exec(text);
  return { text, unchecked, href: arxiv ? `https://arxiv.org/abs/${arxiv[1]}` : undefined };
};
/**
 * Sources other than the result's own papers: those are already listed, with dates and Lean
 * status, under "The original", so they are not repeated here. The JSON keeps every source.
 */
const ownLinks = new Set(
  [...family.papers.map((p) => p.pdf), family.trace, family.leanDoc && (family.leanDoc.startsWith('http') ? family.leanDoc : `https://github.com/openai/math/blob/main/${family.leanDoc}`)]
    .filter((u): u is string => !!u)
    .map((u) => u.replace(/\/$/, '')),
);
const otherSources = (entry?.sources ?? []).filter((s) => {
  const href = s.url ?? cleanCite(s.cite).href;
  return !(href && ownLinks.has(href.replace(/\/$/, '')) && !s.quote);
});
const toc = entry
  ? [
      ...(paragraphs.length > 0
        ? [
            { href: '#the-explanation', label: 'The explanation' },
            { href: '#where-it-came-from', label: 'Where it came from' },
          ]
        : sections.map((s) => ({
            href: `#${s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
            label: s.title,
          }))),
      { href: '#hype-check', label: 'Hype check' },
      { href: '#words-used', label: 'Words used' },
      { href: '#the-original', label: 'The original' },
      ...(cited.length > 0 ? [{ href: '#in-the-papers-words', label: 'Quoted lines' }] : []),
      ...(otherSources.length > 0 ? [{ href: '#sources', label: 'Other sources' }] : []),
    ]
  : [{ href: '#the-original', label: 'The original' }];
const withdrawnCount = family.withdrawn?.length ?? 0;
const withdrawnOn = family.withdrawn?.[0]?.withdrawnOn ?? null;
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const anyUnchecked = !!entry && entry.status !== 'reviewed' && otherSources.some((x) => /†\s*$/.test(x.cite));
const firstDate = family.papers.map((p) => p.date).filter(Boolean).sort()[0] ?? null;
const ogImage = `/og/entry-${globalIdFor(catalog.collection, family.id)}.png`;
---
<Base title={title} description={clip(toPlain(entry?.headline ?? family.summary), 200)} ogImage={ogImage}>
  <div class="entry-wrap">
    <article class="entry">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={appUrl('/archive/')}>Archive</a><span aria-hidden="true">/</span>
        <a href={fieldUrl(family.subject)}>{family.subject}</a><span aria-hidden="true">/</span>
        <span class="num" aria-current="page">Entry {family.id}</span>
      </nav>
      <h1 set:html={renderMath(family.title)} />
      {entry && <p class="headline">{entry.headline}</p>}
      <div class="e-meta">
        {!entry && <TrustLabel trust={family.trust} />}
        <span>{family.papers.length} paper{family.papers.length === 1 ? '' : 's'}</span>
        {firstDate && <span>{formatLongDay(firstDate)}</span>}
        {reviewNote && <span class="e-pill" title={reviewNote}>Explained by AI</span>}
      </div>
      {withdrawnCount > 0 && (
        <p class="wd-note" role="note">
          <span class="wd-badge">Update</span>
          OpenAI withdrew {withdrawnCount === 1 ? 'one paper' : `${withdrawnCount} papers`} from this result{withdrawnOn ? ` on ${formatLongDay(withdrawnOn)}` : ''} after finding a gap in a proof. <a href="#withdrawn">What changed</a>
        </p>
      )}

      {entry ? (
        <>
          <p class="e-lead" set:html={renderMath(entry.plain)} />
          <Scorecard entry={entry} trust={family.trust} papers={family.papers.length} />
          {entry.visual && (
            <RecordChart title={entry.visual.title} note={entry.visual.note} points={entry.visual.points} />
          )}
          {paragraphs.length > 0 && (
            <section class="e-sec e-prose" aria-labelledby="the-explanation">
              <h2 id="the-explanation">The explanation</h2>
              {paragraphHtml.map((h) => <p set:html={h} />)}
              <p class="e-limit"><b>What it doesn't show.</b> {entry.doesNot}</p>
            </section>
          )}
          {paragraphs.length > 0 && (
            <section class="e-ai" aria-labelledby="where-it-came-from">
              <h2 id="where-it-came-from"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3.5"/></svg>Where it came from</h2>
              {aiSection ? (
                <>
                  <p set:html={renderMath(aiSection.body)} />
                  <p class="e-ai-o">{entry.origin}</p>
                </>
              ) : (
                <p class="e-ai-solo">{entry.origin}</p>
              )}
            </section>
          )}
          {sections.filter((s) => s.title !== 'What it says about AI').map((s, i) => (
            <section class="e-sec" aria-labelledby={slug(s.title)}>
              <h2 id={slug(s.title)}><span class="e-n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2>
              <p set:html={renderMath(s.body)} />
              {s.title === 'Why it matters' && <p class="e-limit"><b>What it doesn't show.</b> {entry.doesNot}</p>}
            </section>
          ))}
          {sections.filter((s) => s.title === 'What it says about AI').map((s) => (
            <section class="e-ai" aria-labelledby={slug(s.title)}>
              <h2 id={slug(s.title)}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3.5"/></svg>{s.title}</h2>
              <p set:html={renderMath(s.body)} />
              <p class="e-ai-o">{entry.origin}</p>
            </section>
          ))}
          <section class="e-hype" aria-labelledby="hype-check">
            <h2 id="hype-check">Hype check</h2>
            <p>{entry.hypeCheck}</p>
          </section>
          <Glossary items={entry.glossary} />
          <OriginalPapers family={family} />
          {cited.length > 0 && (
            <section class="e-cites" aria-labelledby="in-the-papers-words">
              {/* Every quote already opens from its numeral, so the full list stays folded. */}
              <details class="cites-d">
                <summary>
                  <h2 id="in-the-papers-words">All quoted lines <span class="num">({cited.length})</span></h2>
                </summary>
                <ol class="cites">
                  {cited.map((c) => (
                    <li id={`cite-${c.n}`} tabindex="-1">
                      <span class="cites-n num" aria-hidden="true">{c.n}</span>
                      <blockquote class="cites-q" id={`cite-${c.n}-q`} set:html={renderQuote(c.quote)} />
                      <span class="cites-m" data-paper={c.paper.name}>
                        {c.paper.href ? <a href={c.paper.href} target="_blank" rel="noopener">{c.paper.name}</a> : <span>{c.paper.name}</span>}
                        <a class="cites-back" href={`#cref-${c.n}`} aria-label={`Back to the text for source ${c.n}`}>Back to text</a>
                      </span>
                    </li>
                  ))}
                </ol>
              </details>
            </section>
          )}
          {otherSources.length > 0 && (
            <section class="e-refs" aria-labelledby="sources">
              <h2 id="sources">Other sources</h2>
              {anyUnchecked && <p class="e-refs-n"><i aria-hidden="true"></i>Marked sources have not yet been checked against the original text.</p>}
              <ol class="refs">
                {otherSources.map((s) => {
                  const c = cleanCite(s.cite);
                  const href = s.url ?? c.href;
                  return (
                    <li>
                      <span>{href ? <a href={href} target="_blank" rel="noopener">{c.text}</a> : c.text}{c.unchecked && entry.status !== 'reviewed' && <i class="ref-u" role="img" aria-label="Not yet checked against the source"></i>}</span>
                      {s.quote && <q set:html={renderQuote(s.quote)} />}
                    </li>
                  );
                })}
              </ol>
            </section>
          )}
        </>
      ) : (
        <>
          <div class="claimbox">
            <div class="label">What the paper claims, in its own words</div>
            <p set:html={renderMath(family.summary)} />
          </div>
          <Notice text="The plain-language explainer for this entry is still coming." />
          <OriginalPapers family={family} />
        </>
      )}
      <nav class="pn" aria-label="Previous and next entries">
        {prev ? <a class="pn-prev" href={entryUrl(prev)}><span class="label">← Previous · <span class="num">{prev.id}</span></span><span class="t">{toPlain(prev.title)}</span></a> : <span />}
        {next ? <a class="pn-next" href={entryUrl(next)}><span class="label">Next · <span class="num">{next.id}</span> →</span><span class="t">{toPlain(next.title)}</span></a> : <span />}
      </nav>
    </article>
    <aside class="side" aria-label="On this page">
      <div class="blk toc">
        <div class="label" style="margin-block-end:.375rem">On this page</div>
        {toc.map((t) => (
          <a href={t.href} data-h={t.href.slice(1)}>{t.label}</a>
        ))}
      </div>
      <div class="blk">
        <a class="share" href={shareHref} target="_blank" rel="noopener" aria-label="Share on X (opens in a new tab)">
          <span aria-hidden="true">Share on</span>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23 22h-6.2l-4.8-6.3L6.4 22H3.3l7.3-8.3L1 2h6.3l4.4 5.8zm-1.1 18h1.7L6.3 3.9H4.5z" /></svg>
        </a>
      </div>
      <div class="blk">
        <div class="label" style="margin-block-end:.375rem">Feedback</div>
        <a href={reportHref}>Report an error</a>
      </div>
    </aside>
  </div>
  <script>
    const tocLinks = [...document.querySelectorAll('.side .toc a')] as HTMLAnchorElement[];
    tocLinks.forEach((a) => {
      a.addEventListener('click', (ev) => {
        ev.preventDefault();
        document
          .getElementById(a.dataset.h ?? '')
          ?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    });
    const io = new IntersectionObserver(
      (es) => es.forEach((x) => {
        if (x.isIntersecting) {
          tocLinks.forEach((l) => (l.dataset.h === (x.target as HTMLElement).id ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));
        }
      }),
      { rootMargin: '-20% 0px -70% 0px' },
    );
    tocLinks.forEach((l) => {
      const t = document.getElementById(l.dataset.h ?? '');
      if (t) io.observe(t);
    });
    // Inline citations: a raised numeral opens a small card with the exact paper line.
    // Hover opens it on a mouse; click or tap pins it. Esc, an outside tap, or moving
    // focus away closes it. Without JS the numeral is a plain link to the quote.
    // The full quote list is folded in a <details>; open it whenever a link points inside it.
    const openFold = (el: Element | null) => {
      const d = el?.closest('details');
      if (d && !d.open) d.open = true;
    };
    const openForHash = () => {
      if (location.hash.length > 1) openFold(document.getElementById(decodeURIComponent(location.hash.slice(1))));
    };
    openForHash();
    window.addEventListener('hashchange', openForHash);
    const cites = [...document.querySelectorAll('.cite-a')] as HTMLAnchorElement[];
    if (cites.length > 0) {
      const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pop = document.createElement('span');
      pop.className = 'cite-pop';
      pop.id = 'cite-pop';
      pop.setAttribute('role', 'dialog');
      pop.hidden = true;
      pop.innerHTML =
        '<span class="cite-pop-q"></span><span class="cite-pop-m"><span class="cite-pop-p"></span><a class="cite-pop-go" href="#">Go to source</a></span>';
      const q = pop.querySelector('.cite-pop-q') as HTMLElement;
      const paper = pop.querySelector('.cite-pop-p') as HTMLElement;
      const go = pop.querySelector('.cite-pop-go') as HTMLAnchorElement;
      let current: HTMLAnchorElement | null = null;
      let pinned = false;
      let hoverTimer = 0;
      // After the reader dismisses a card (Esc, a second click), hovering the same numeral
      // must not reopen it until the pointer has left it once.
      let noHover: HTMLAnchorElement | null = null;

      const place = () => {
        if (!current) return;
        const r = current.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        const vh = window.innerHeight;
        const m = 12;
        const w = pop.offsetWidth;
        const h = pop.offsetHeight;
        const left = Math.min(Math.max(r.left + r.width / 2 - w / 2, m), vw - w - m);
        const below = r.bottom + 8;
        const top = below + h > vh - m && r.top - 8 - h > m ? r.top - 8 - h : below;
        pop.style.left = `${Math.round(left)}px`;
        pop.style.top = `${Math.round(top)}px`;
        pop.style.setProperty('--cite-x', `${Math.round(r.left + r.width / 2 - left)}px`);
        pop.dataset.side = top < r.top ? 'top' : 'bottom';
      };

      const open = (a: HTMLAnchorElement, pin: boolean) => {
        window.clearTimeout(hoverTimer);
        if (current && current !== a) current.setAttribute('aria-expanded', 'false');
        const n = a.dataset.cite ?? '';
        const item = document.getElementById(`cite-${n}`);
        const quote = document.getElementById(`cite-${n}-q`);
        if (!item || !quote) return;
        current = a;
        pinned = pin || pinned;
        q.innerHTML = quote.innerHTML;
        paper.textContent = (item.querySelector('.cites-m') as HTMLElement | null)?.dataset.paper ?? '';
        go.href = `#cite-${n}`;
        pop.setAttribute('aria-label', `Source ${n}, from the paper`);
        // Keep the card right after its numeral, so Tab moves from the numeral into "Go to source".
        a.parentElement?.after(pop);
        pop.hidden = false;
        a.setAttribute('aria-expanded', 'true');
        a.setAttribute('aria-controls', 'cite-pop');
        place();
      };

      const close = (refocus = false) => {
        window.clearTimeout(hoverTimer);
        if (!current) return;
        const a = current;
        a.setAttribute('aria-expanded', 'false');
        // The card can sit under the pointer (it opens next to the numeral's enlarged hit
        // area); when it disappears the pointer lands back on the numeral.
        noHover = a.matches(':hover') || pop.matches(':hover') ? a : null;
        pop.hidden = true;
        current = null;
        pinned = false;
        if (refocus) a.focus();
      };

      cites.forEach((a) => {
        a.addEventListener('click', (ev) => {
          ev.preventDefault();
          if (current === a && pinned) close();
          else open(a, true);
        });
        a.addEventListener('pointerenter', (ev) => {
          if (ev.pointerType !== 'mouse' || pinned || noHover === a) return;
          window.clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(() => open(a, false), 120);
        });
        a.addEventListener('pointerleave', (ev) => {
          if (noHover === a) noHover = null;
          if (ev.pointerType !== 'mouse' || pinned) return;
          window.clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(() => close(), 220);
        });
      });
      pop.addEventListener('pointerenter', () => window.clearTimeout(hoverTimer));
      pop.addEventListener('pointerleave', (ev) => {
        if (ev.pointerType !== 'mouse' || pinned) return;
        hoverTimer = window.setTimeout(() => close(), 220);
      });

      go.addEventListener('click', (ev) => {
        ev.preventDefault();
        const target = document.getElementById(go.hash.slice(1));
        close();
        if (!target) return;
        openFold(target);
        target.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'center' });
        target.focus({ preventScroll: true });
        target.classList.remove('is-flash');
        void target.offsetWidth;
        target.classList.add('is-flash');
        window.setTimeout(() => target.classList.remove('is-flash'), 1800);
        history.replaceState(null, '', go.hash);
      });

      document.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape' && current) close(true);
      });
      document.addEventListener('pointerdown', (ev) => {
        const t = ev.target as Node;
        if (current && !pop.contains(t) && !current.contains(t)) close();
      });
      pop.addEventListener('focusout', (ev) => {
        const t = ev.relatedTarget as Node | null;
        if (current && t && !pop.contains(t) && t !== current) close();
      });
      cites.forEach((a) =>
        a.addEventListener('focusout', (ev) => {
          const t = ev.relatedTarget as Node | null;
          if (current === a && t && !pop.contains(t)) close();
        }),
      );
      window.addEventListener('resize', place, { passive: true });
      window.addEventListener('scroll', place, { passive: true });
    }
  </script>
</Base>
