---
import Base from '../../layouts/Base.astro';
import Scorecard from '../../components/Scorecard.astro';
import RecordChart from '../../components/RecordChart.astro';
import Notice from '../../components/Notice.astro';
import Glossary from '../../components/Glossary.astro';
import OriginalPapers from '../../components/OriginalPapers.astro';
import TrustLabel from '../../components/TrustLabel.astro';
import { absoluteUrl, appUrl, catalog, entryUrl, familiesById, loadExplained, neighbors } from '../../lib/site.js';
import { globalIdFor, parseGlobalId } from '../../lib/ids.js';
import { renderMath } from '../../lib/katex.js';

export async function getStaticPaths() {
  return catalog.families.map((f) => ({
    params: { gid: globalIdFor(catalog.collection, f.id) },
  }));
}

const { gid } = Astro.params;
const parsed = parseGlobalId(gid ?? '');
const family = parsed ? familiesById.get(parsed.id) : undefined;
if (!family) throw new Error(`Unknown entry: ${gid}`);

const explained = await loadExplained();
const entry = explained.get(family.id) ?? null;
const { prev, next } = neighbors(family.id);

const reviewNote =
  entry && entry.status !== 'reviewed' ? 'This entry has not been reviewed by a person yet.' : null;
const reviewKind =
  entry?.status === 'sample'
    ? 'Sample entry, written by hand'
    : entry?.status === 'ai-draft'
      ? 'AI draft — not checked yet'
      : entry?.status === 'ai-checked'
        ? 'Checked by AI against the paper — not yet reviewed by a person'
        : entry?.status === 'reviewed'
          ? `Reviewed by a person${entry.reviewedBy ? ` (${entry.reviewedBy})` : ''}`
          : null;

const shareText = entry
  ? `${entry.scorecard.firstStep ? `Open since ${entry.scorecard.firstStep}. ` : ''}${entry.headline} ∎ ${absoluteUrl(entryUrl(family))}`
  : `${family.title.replace(/<[^>]+>/g, '')} ∎ ${absoluteUrl(entryUrl(family))}`;
const shareHref = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}`;
const reportHref =
  `https://github.com/nishachay/closed-form/issues/new?template=report-error.yml` +
  `&labels=entry-error&title=${encodeURIComponent(`[entry ${family.id}] `)}`;

const toc = entry
  ? [
      ...entry.sections.map((s) => ({
        href: `#${s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
        label: s.title,
      })),
      { href: '#hype-check', label: 'Hype check' },
      { href: '#words-used', label: 'Words used' },
      { href: '#sources', label: 'Sources' },
      { href: '#the-original', label: 'The original' },
    ]
  : [{ href: '#the-original', label: 'The original' }];

const title = `${family.id} · ${family.title.replace(/<[^>]+>/g, '')}`;
const ogImage = `/og/entry-${globalIdFor(catalog.collection, family.id)}.png`;
---
<Base title={title} description={entry?.headline ?? family.summary.replace(/<[^>]+>/g, '')} ogImage={ogImage}>
  <div class="entry-wrap">
    <article class="entry">
      <div class="label">Entry <span class="num">{family.id}</span> · {family.subject}</div>
      <h1 set:html={renderMath(family.title)} />

      {entry ? (
        <>
          <p class="headline">{entry.headline}</p>
          <p class="scope">{entry.scope}</p>
          <p set:html={renderMath(entry.plain)} />
          {reviewNote && <Notice text={reviewNote} />}
          {reviewKind && <p class="ui review-kind">{reviewKind}</p>}
          <Scorecard entry={entry} trust={family.trust} papers={family.papers.length} />
          {entry.visual && (
            <RecordChart title={entry.visual.title} note={entry.visual.note} points={entry.visual.points} />
          )}
          {entry.sections.map((s) => (
            <section aria-label={s.title}>
              <h2 id={s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{s.title}</h2>
              <p set:html={renderMath(s.body)} />
              {s.title === 'Why it matters' && <p>{entry.doesNot}</p>}
              {s.title === 'What it says about AI' && <p>{entry.origin}</p>}
            </section>
          ))}
          <section aria-labelledby="hype-check">
            <h2 id="hype-check">Hype check</h2>
            <p class="hype">{entry.hypeCheck}</p>
          </section>
          <Glossary items={entry.glossary} />
          <section aria-labelledby="sources">
            <h2 id="sources">Sources</h2>
            <ul class="papers">
              {entry.sources.map((s) => (
                <li>
                  {s.url ? <a href={s.url} target="_blank" rel="noopener">{s.cite}</a> : s.cite}
                  {s.quote && <div class="d">“{s.quote}”</div>}
                </li>
              ))}
            </ul>
          </section>
          <OriginalPapers family={family} />
          <nav class="pn" aria-label="Previous and next entries">
            <span>{prev && <a href={entryUrl(prev)}><div class="label">← {prev.id}</div><div class="t">{prev.title.replace(/<[^>]+>/g, '')}</div></a>}</span>
            <span>{next && <a href={entryUrl(next)}><div class="label">{next.id} →</div><div class="t">{next.title.replace(/<[^>]+>/g, '')}</div></a>}</span>
          </nav>
        </>
      ) : (
        <>
          <div class="claimbox">
            <div class="label">What the paper claims, in its own words</div>
            <p set:html={renderMath(family.summary)} />
            <div class="claim-foot">
              <TrustLabel trust={family.trust} />
              <a href={family.papers[0].pdf} target="_blank" rel="noopener">Read the paper →</a>
            </div>
          </div>
          <Notice text="The plain-language explainer for this entry is still coming." />
          <OriginalPapers family={family} />
          <nav class="pn" aria-label="Previous and next entries">
            <span>{prev && <a href={entryUrl(prev)}><div class="label">← {prev.id}</div><div class="t">{prev.title.replace(/<[^>]+>/g, '')}</div></a>}</span>
            <span>{next && <a href={entryUrl(next)}><div class="label">{next.id} →</div><div class="t">{next.title.replace(/<[^>]+>/g, '')}</div></a>}</span>
          </nav>
        </>
      )}
    </article>
    <aside class="side" aria-label="On this page">
      <div class="blk toc">
        <div class="label" style="margin-block-end:.375rem">On this page</div>
        {toc.map((t) => (
          <a href={t.href} data-h={t.href.slice(1)}>{t.label}</a>
        ))}
      </div>
      <div class="blk">
        <a class="share" href={shareHref} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23 22h-6.2l-4.8-6.3L6.4 22H3.3l7.3-8.3L1 2h6.3l4.4 5.8zm-1.1 18h1.7L6.3 3.9H4.5z" /></svg>Share on X
        </a>
      </div>
      <div class="blk">
        <div class="label" style="margin-block-end:.375rem">Trust</div>
        <TrustLabel trust={family.trust} />
      </div>
      <div class="blk">
        <div class="label" style="margin-block-end:.375rem">Feedback</div>
        <a href={reportHref}>Report an error</a>
      </div>
    </aside>
  </div>
  <div class="wrap">
    <p class="ui" style="margin-block-start: var(--space-8)">
      Collection: <a href={appUrl(`/collection/${catalog.collection}/`)}>{catalog.collection}</a> · Lab:{' '}
      <a href={appUrl(`/lab/${catalog.lab}/`)}>{catalog.lab}</a> · Science:{' '}
      <a href={appUrl(`/science/${catalog.science}/`)}>{catalog.science}</a>
    </p>
  </div>
  <script>
    const tocLinks = [...document.querySelectorAll('.side .toc a')] as HTMLAnchorElement[];
    tocLinks.forEach((a) => {
      a.addEventListener('click', (ev) => {
        ev.preventDefault();
        document
          .getElementById(a.dataset.h ?? '')
          ?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    });
    const io = new IntersectionObserver(
      (es) => es.forEach((x) => {
        if (x.isIntersecting) {
          tocLinks.forEach((l) => (l.dataset.h === (x.target as HTMLElement).id ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));
        }
      }),
      { rootMargin: '-20% 0px -70% 0px' },
    );
    tocLinks.forEach((l) => {
      const t = document.getElementById(l.dataset.h ?? '');
      if (t) io.observe(t);
    });
  </script>
</Base>
