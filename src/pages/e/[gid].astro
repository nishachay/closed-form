---
import Base from '../../layouts/Base.astro';
import Scorecard from '../../components/Scorecard.astro';
import RecordChart from '../../components/RecordChart.astro';
import Notice from '../../components/Notice.astro';
import Glossary from '../../components/Glossary.astro';
import OriginalPapers from '../../components/OriginalPapers.astro';
import TrustLabel from '../../components/TrustLabel.astro';
import { absoluteUrl, appUrl, catalog, entryUrl, familiesById, loadExplained, neighbors } from '../../lib/site.js';
import { globalIdFor, parseGlobalId } from '../../lib/ids.js';
import { renderMath } from '../../lib/katex.js';

export async function getStaticPaths() {
  return catalog.families.map((f) => ({
    params: { gid: globalIdFor(catalog.collection, f.id) },
  }));
}

const { gid } = Astro.params;
const parsed = parseGlobalId(gid ?? '');
const family = parsed ? familiesById.get(parsed.id) : undefined;
if (!family) throw new Error(`Unknown entry: ${gid}`);

const explained = await loadExplained();
const entry = explained.get(family.id) ?? null;
const { prev, next } = neighbors(family.id);

const reviewNote =
  entry && entry.status !== 'reviewed' ? 'This entry has not been reviewed by a person yet.' : null;
const reviewKind =
  entry?.status === 'sample'
    ? 'Sample entry, written by hand'
    : entry?.status === 'ai-draft'
      ? 'AI draft — not checked yet'
      : entry?.status === 'ai-checked'
        ? 'Checked by AI against the paper — not yet reviewed by a person'
        : entry?.status === 'reviewed'
          ? `Reviewed by a person${entry.reviewedBy ? ` (${entry.reviewedBy})` : ''}`
          : null;

const shareText = entry
  ? `${entry.scorecard.firstStep ? `Open since ${entry.scorecard.firstStep}. ` : ''}${entry.headline} ∎ ${absoluteUrl(entryUrl(family))}`
  : `${family.title.replace(/<[^>]+>/g, '')} ∎ ${absoluteUrl(entryUrl(family))}`;
const shareHref = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}`;

const toc = entry
  ? [
      ...entry.sections.map((s) => ({
        href: `#${s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
        label: s.title,
      })),
      { href: '#hype-check', label: 'Hype check' },
      { href: '#words-used', label: 'Words used' },
      { href: '#sources', label: 'Sources' },
      { href: '#the-original', label: 'The original' },
    ]
  : [{ href: '#the-original', label: 'The original' }];

const title = `${family.id} · ${family.title.replace(/<[^>]+>/g, '')}`;
const ogImage = `/og/entry-${globalIdFor(catalog.collection, family.id)}.png`;
---
<Base title={title} description={entry?.headline ?? family.summary.replace(/<[^>]+>/g, '')} ogImage={ogImage}>
  <div class="wrap">
    <p class="kicker">
      Entry {family.id} · {family.subject}
    </p>
    <h1 class="page" set:html={renderMath(family.title)} />

    {entry ? (
      <div class="entry-grid">
        <article class="measure">
          <p class="headline">{entry.headline}</p>
          <p class="scope">{entry.scope}</p>
          <p>{entry.plain}</p>
          {reviewNote && <Notice text={reviewNote} />}
          {reviewKind && <p class="ui">{reviewKind}</p>}
          <Scorecard entry={entry} trust={family.trust} />
          {entry.visual && (
            <RecordChart title={entry.visual.title} note={entry.visual.note} points={entry.visual.points} />
          )}
          {entry.sections.map((s) => (
            <section aria-label={s.title}>
              <h2 id={s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{s.title}</h2>
              <p>{s.body}</p>
              {s.title === 'Why it matters' && <p>{entry.doesNot}</p>}
              {s.title === 'What it says about AI' && <p>{entry.origin}</p>}
            </section>
          ))}
          <section aria-labelledby="hype-check">
            <h2 id="hype-check">Hype check</h2>
            <p>{entry.hypeCheck}</p>
          </section>
          <Glossary items={entry.glossary} />
          <section aria-labelledby="sources">
            <h2 id="sources">Sources</h2>
            <ol class="sources">
              {entry.sources.map((s) => (
                <li>
                  {s.url ? <a href={s.url}>{s.cite}</a> : s.cite}
                  {s.quote && <span> — “{s.quote}”</span>}
                </li>
              ))}
            </ol>
          </section>
          <OriginalPapers family={family} />
          <nav class="pager" aria-label="More entries">
            <span>{prev && <a href={entryUrl(prev)}>← {prev.id} · <span set:html={prev.title.replace(/\$[^$]+\$/g, '')} /></a>}</span>
            <span>{next && <a href={entryUrl(next)}>{next.id} · <span set:html={next.title.replace(/\$[^$]+\$/g, '')} /> →</a>}</span>
          </nav>
        </article>
        <aside class="entry-side" aria-label="On this page">
          <p class="label">On this page</p>
          <ul>
            {toc.map((t) => (
              <li>
                <a href={t.href}>{t.label}</a>
              </li>
            ))}
          </ul>
          <p class="label">Share</p>
          <p>
            <a href={shareHref}>Share on X</a>
          </p>
          <p class="label">Trust</p>
          <p>
            <TrustLabel trust={family.trust} />
          </p>
        </aside>
      </div>
    ) : (
      <div class="entry-grid">
        <article class="measure">
          <h2 class="headline">What the paper claims, in its own words</h2>
          <p set:html={renderMath(family.summary)} />
          <p>
            <TrustLabel trust={family.trust} />
          </p>
          <Notice text="The plain-language explainer for this entry is still coming." />
          <OriginalPapers family={family} />
          <nav class="pager" aria-label="More entries">
            <span>{prev && <a href={entryUrl(prev)}>← {prev.id}</a>}</span>
            <span>{next && <a href={entryUrl(next)}>{next.id} →</a>}</span>
          </nav>
        </article>
        <aside class="entry-side" aria-label="On this page">
          <p class="label">On this page</p>
          <ul>
            {toc.map((t) => (
              <li>
                <a href={t.href}>{t.label}</a>
              </li>
            ))}
          </ul>
          <p class="label">Share</p>
          <p>
            <a href={shareHref}>Share on X</a>
          </p>
          <p class="label">Trust</p>
          <p>
            <TrustLabel trust={family.trust} />
          </p>
        </aside>
      </div>
    )}

    <p class="ui" style="margin-block-start: var(--space-8)">
      Collection: <a href={appUrl(`/collection/${catalog.collection}/`)}>{catalog.collection}</a> · Lab:{' '}
      <a href={appUrl(`/lab/${catalog.lab}/`)}>{catalog.lab}</a> · Science:{' '}
      <a href={appUrl(`/science/${catalog.science}/`)}>{catalog.science}</a>
    </p>
  </div>
</Base>
