---
import Base from '../../../layouts/Base.astro';
import ArchiveBrowser from '../../../components/ArchiveBrowser.astro';
import { appUrl, catalog, collectionName, scienceName } from '../../../lib/site.js';
import { slugify } from '../../../lib/slug.js';

export function getStaticPaths() {
  return catalog.subjects.map((s) => ({
    params: { science: catalog.science, field: slugify(s) },
  }));
}

const { field } = Astro.params;
const subject = catalog.subjects.find((s) => slugify(s) === field);
if (!subject) throw new Error(`Unknown field: ${field}`);
const list = catalog.families.filter((f) => f.subject === subject);
---
<Base
  title={subject}
  description={`${list.length} AI-made results in ${subject}, explained in plain words.`}
  ogImage={`/og/field-${field}.png`}
>
    <section class="wrap arch-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={appUrl('/archive/')}>Archive</a><span aria-hidden="true">/</span><a href={appUrl(`/science/${catalog.science}/`)}>{scienceName()}</a><span aria-hidden="true">/</span><span aria-current="page">Field</span></nav>
      <h1>{subject}</h1>
      <p class="lede"><span class="num">{list.length}</span> results in {collectionName()}.</p>
    </section>
    <ArchiveBrowser families={list} lockField={slugify(subject)} />
</Base>
