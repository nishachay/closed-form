---
import Base from '../../../layouts/Base.astro';
import ArchiveBrowser from '../../../components/ArchiveBrowser.astro';
import { appUrl, catalog, fieldUrl } from '../../../lib/site.js';
import { slugify } from '../../../lib/slug.js';

export function getStaticPaths() {
  return catalog.subjects.map((s) => ({
    params: { science: catalog.science, field: slugify(s) },
  }));
}

const { field } = Astro.params;
const subject = catalog.subjects.find((s) => slugify(s) === field);
if (!subject) throw new Error(`Unknown field: ${field}`);
const list = catalog.families.filter((f) => f.subject === subject);
---
<Base title={subject} description={`${list.length} AI-made results in ${subject}, explained in plain words.`}>
  <div class="wrap">
    <p class="kicker">
      Field · {subject} · <a href={appUrl(`/science/${catalog.science}/`)}>{catalog.science}</a>
    </p>
    <h1 class="page">{subject}</h1>
    <p class="measure">
      {list.length} results in {catalog.collection} · <a href={fieldUrl(subject)}>permalink</a>
    </p>
    <ArchiveBrowser families={list} />
  </div>
</Base>
