---
import Base from '../../layouts/Base.astro';
import { appUrl, catalog, computeStats, fieldUrl } from '../../lib/site.js';

export function getStaticPaths() {
  return [{ params: { science: catalog.science } }];
}

const stats = computeStats();
const { science } = Astro.params;
---
<Base title={`Science: ${science}`} description={`AI-made ${science}, explained with honest trust labels.`}>
  <div class="wrap">
    <p class="kicker">Science · {science}</p>
    <h1 class="page">{science === 'mathematics' ? 'Mathematics' : science}</h1>
    <p class="measure">
      {stats.results} results in {stats.papers} papers across {catalog.subjects.length} fields, from{' '}
      {stats.results} AI-made result families.
    </p>

    <h2>Collections</h2>
    <ul class="rows">
      <li class="row">
        <a class="row-link" href={appUrl(`/collection/${catalog.collection}/`)}>
          <span class="row-id nums">Vol. 1</span>
          <span>
            <span class="row-title">{catalog.collection}</span>
            <span class="row-summary">
              Lab: {catalog.lab} · {stats.results} results · {stats.papers} papers
            </span>
          </span>
          <span class="row-trust" />
        </a>
      </li>
    </ul>

    <h2>Fields</h2>
    <ul class="rows">
      {catalog.subjects.map((s) => {
        const n = catalog.families.filter((f) => f.subject === s).length;
        return (
          <li class="row">
            <a class="row-link" href={fieldUrl(s)}>
              <span class="row-id nums">{n}</span>
              <span>
                <span class="row-title">{s}</span>
              </span>
              <span class="row-trust" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
