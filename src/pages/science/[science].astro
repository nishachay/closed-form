---
import Base from '../../layouts/Base.astro';
import FieldCards from '../../components/FieldCards.astro';
import MapLegend from '../../components/MapLegend.astro';
import { appUrl, catalog, collectionName, computeStats, labName, scienceName } from '../../lib/site.js';

export function getStaticPaths() {
  return [{ params: { science: catalog.science } }];
}

const stats = computeStats();
const name = scienceName();
---
<Base
  title={name}
  description={`AI-made ${scienceName().toLowerCase()}, explained in plain words with honest trust labels.`}
  ogImage={`/og/science-${catalog.science}.png`}
>
  <div class="wrap">
    <section class="arch-head">
      <div class="label">Science</div>
      <h1>{name}</h1>
      <p class="lede">
        <span class="num">{stats.results}</span> results from <span class="num">{stats.papers}</span> papers across <span class="num">{catalog.subjects.length}</span> fields.
      </p>
    </section>
    <h2 class="label hub-h">Collections</h2>
    <a class="hub-card" href={appUrl(`/collection/${catalog.collection}/`)}>
      <span class="hub-t">{collectionName()}</span>
      <span class="hub-m">{labName()} · {scienceName()} · <span class="num">{stats.results}</span> results · <span class="num">{stats.papers}</span> papers</span>
      <span class="hub-go" aria-hidden="true">Open →</span>
    </a>
    <section class="map" aria-labelledby="map-h">
      <div class="sec-head"><h2 class="label" id="map-h">Fields · one square per result</h2><MapLegend /></div>
      <ul class="fields"><FieldCards subjects={catalog.subjects} families={catalog.families} /></ul>
    </section>
  </div>
</Base>
