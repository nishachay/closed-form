---
import Base from '../../layouts/Base.astro';
import { appUrl, catalog, computeStats, fieldUrl } from '../../lib/site.js';

export function getStaticPaths() {
  return [{ params: { science: catalog.science } }];
}

const stats = computeStats();
const { science } = Astro.params;
---
<Base
  title={`Science: ${science}`}
  description={`AI-made ${science}, explained with honest trust labels.`}
  ogImage={`/og/science-${science}.png`}
>
  <div class="wrap">
    <section class="arch-head">
      <div class="label">Science · {science}</div>
      <h1>{science === 'mathematics' ? 'Mathematics' : science}</h1>
      <p class="lede">
        {stats.results} results in {stats.papers} papers across {catalog.subjects.length} fields.
      </p>
    </section>
    <h2 class="label">Collections</h2>
    <ul class="papers">
      <li>
        <a href={appUrl(`/collection/${catalog.collection}/`)}>{catalog.collection}</a>
        <div class="d">Lab: {catalog.lab} · {stats.results} results · {stats.papers} papers</div>
      </li>
    </ul>
    <h2 class="label" style="margin-block-start:2rem">Fields</h2>
    <ul class="papers">
      {catalog.subjects.map((s) => {
        const n = catalog.families.filter((f) => f.subject === s).length;
        return (
          <li>
            <a href={fieldUrl(s)}>{s}</a>
            <div class="d"><span class="num">{n}</span> results</div>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
