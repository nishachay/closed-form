---
import Base from '../../layouts/Base.astro';
import FieldCards from '../../components/FieldCards.astro';
import MapLegend from '../../components/MapLegend.astro';
import ArchiveBrowser from '../../components/ArchiveBrowser.astro';
import { appUrl, catalog, collectionName, computeStats, families, labName, scienceName } from '../../lib/site.js';

export function getStaticPaths() {
  return [{ params: { collection: catalog.collection } }];
}

const stats = computeStats();
const name = collectionName();
---
<Base
  title={name}
  description={`${stats.results} results, ${stats.papers} papers, honest trust labels.`}
  ogImage={`/og/collection-${catalog.collection}.png`}
>
  <div class="wrap">
    <section class="arch-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={appUrl(`/science/${catalog.science}/`)}>{scienceName()}</a><span aria-hidden="true">/</span><a href={appUrl(`/lab/${catalog.lab}/`)}>{labName()}</a><span aria-hidden="true">/</span><span aria-current="page">Collection</span></nav>
      <h1>{name}</h1>
      <p class="lede">
        {stats.results} results in {stats.papers} papers across {catalog.subjects.length} fields.
        Released by {labName()} in the <a href={`https://github.com/${catalog.source.repo}`} target="_blank" rel="noopener">{catalog.source.repo}</a> repository.
      </p>
    </section>
    <div class="stats" style="margin-block-start:2rem">
      <div class="stat">
        <div class="label">Papers</div>
        <div class="n num">{stats.papers}</div>
      </div>
      <div class="stat">
        <div class="label">Results</div>
        <div class="n num">{stats.results}</div>
      </div>
      <div class="stat">
        <div class="label">Formal proofs</div>
        <div class="n num">{stats.formalPapers}</div>
      </div>
      <div class="stat">
        <div class="label">Fields</div>
        <div class="n num">{catalog.subjects.length}</div>
      </div>
    </div>
    <section class="map" aria-labelledby="map-h">
      <div class="sec-head">
        <h2 class="label" id="map-h">Browse by field · one square per result</h2>
        <MapLegend />
      </div>
      <ul class="fields"><FieldCards subjects={catalog.subjects} families={families} /></ul>
    </section>
    <h2 class="label" id="all-results">All results in this collection</h2>
    <ArchiveBrowser families={families} />
  </div>
</Base>
