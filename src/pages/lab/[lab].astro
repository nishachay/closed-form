---
import Base from '../../layouts/Base.astro';
import { appUrl, catalog, computeStats } from '../../lib/site.js';

export function getStaticPaths() {
  return [{ params: { lab: catalog.lab } }];
}

const stats = computeStats();
const { lab } = Astro.params;
---
<Base
  title={`Lab: ${lab}`}
  description={`AI-made mathematics from ${lab}, explained with honest trust labels.`}
  ogImage={`/og/lab-${lab}.png`}
>
  <div class="wrap">
    <section class="arch-head">
      <div class="label">Lab · {lab}</div>
      <h1>{lab === 'openai' ? 'OpenAI' : lab}</h1>
      <p class="lede">
        {stats.results} results in {stats.papers} papers across {catalog.subjects.length} fields of{' '}
        {catalog.science}.
      </p>
    </section>
    <h2 class="label">Collections</h2>
    <ul class="papers">
      <li>
        <a href={appUrl(`/collection/${catalog.collection}/`)}>{catalog.collection}</a>
        <div class="d">Science: {catalog.science} · {stats.results} results · {stats.papers} papers</div>
      </li>
    </ul>
  </div>
</Base>
