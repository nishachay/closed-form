---
import Base from '../layouts/Base.astro';
import FieldCards from '../components/FieldCards.astro';
import { catalog, computeStats, appUrl } from '../lib/site.js';
import { collectionRange } from '../lib/dates.js';
import { TRUST_LADDER } from '../lib/trust.js';

const stats = computeStats();
const range = collectionRange(catalog.families);
---
<Base title="AI mathematics, explained" description={`Every problem an OpenAI model solved, explained in plain words with honest trust labels. ${stats.results} results from ${stats.papers} papers.`} current="home">
  <section class="mast wrap">
      <div class="stage">
        <div class="label">The OpenAI collection · {range}</div>
        <h1>Every problem AI has solved, <span>explained for everyone.</span></h1>
        <p class="lede">
          An OpenAI model released {stats.papers} research papers on open problems in mathematics.
          Closed Form explains each one in plain words: what it proves, why it matters and how far
          you can trust it.
        </p>
        <form class="hero-search" role="search" action={appUrl('/archive/')} method="get">
          <div class="sbox sbox-lg">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <label for="hq" class="sr">Search all results</label>
            <input
              id="hq"
              name="q"
              class="search"
              type="search"
              placeholder={`Search ${stats.results} results, e.g. Riemann, spin glass, matroid`}
              autocomplete="off"
              spellcheck={false}
              enterkeyhint="search"
            />
            <button class="btn-in" type="submit">Search</button>
          </div>
        </form>
        <div class="stats" id="stats">
          <div class="stat">
            <div class="label">Papers</div>
            <div class="n num">{stats.papers}</div>
            <div class="m">released by the model</div>
          </div>
          <div class="stat">
            <div class="label">Results</div>
            <div class="n num">{stats.results}</div>
            <div class="m">after merging related papers</div>
          </div>
          <div class="stat">
            <div class="label">Formal proofs</div>
            <div class="n num">{stats.formalPapers}</div>
            <div class="m">papers with a Lean proof listed</div>
          </div>
          <div class="stat">
            <div class="label">Fields</div>
            <div class="n num">{catalog.subjects.length}</div>
            <div class="m">from number theory to topology</div>
          </div>
        </div>
      </div>


    <section class="map" aria-labelledby="map-h">
      <div class="sec-head">
        <h2 class="label" id="map-h">Browse by field · one square per result</h2>
        <ul class="legend" aria-label="Trust legend">
          {TRUST_LADDER.map((t) => (
            <li><i class={`dot c-${t.key}`} aria-hidden="true"></i>{t.label}</li>
          ))}
        </ul>
      </div>
      <ul class="fields" id="grid">
        <FieldCards subjects={catalog.subjects} families={catalog.families} explainedIds={new Set()} />
        <li class="fcard fcard-all">
          <h3 class="fc-t"><a href={appUrl('/archive/')}>All fields</a></h3>
          <p class="fc-n"><span><b class="num">{stats.results}</b> results in the archive</span></p>
          <span class="fc-go" aria-hidden="true">Open the archive →</span>
        </li>
      </ul>
    </section>

  </section>
  <script>
    const hq = document.getElementById('hq') as HTMLInputElement | null;
    if (hq) {
      const full = hq.placeholder;
      const mq = matchMedia('(max-width: 36rem)');
      const swap = () => {
        const m = hq.placeholder.match(/^Search \d+ results/);
        hq.placeholder = mq.matches ? (m ? m[0] : 'Search results') : full;
      };
      mq.addEventListener?.('change', swap);
      swap();
    }
  </script>
</Base>
