---
import { toPlain } from '../lib/plain.js';
import { entryUrl, fieldUrl } from '../lib/site.js';
import { TRUST_LADDER } from '../lib/trust.js';
import type { Catalog } from '../lib/catalog.js';

interface Props {
  subjects: Catalog['subjects'];
  families: Catalog['families'];
  explainedIds: Set<string>;
}
const { subjects, families, explainedIds } = Astro.props;

const order: Record<string, number> = { formal: 0, partial: 1, claimed: 2 };
---
<>
  {subjects.map((subject) => {
    const items = families
      .filter((f) => f.subject === subject)
      .sort((a, b) => (order[a.trust] ?? 9) - (order[b.trust] ?? 9) || a.id.localeCompare(b.id));
    if (items.length === 0) return null;
    const formal = items.filter((f) => f.trust === 'formal').length;
    return (
      <li class="fcard">
        <h3 class="fc-t"><a href={fieldUrl(subject)}>{subject}</a></h3>
        <ul class="cells">
          {items.map((f) => {
            const plain = toPlain(f.title);
            return (
              <li>
                <a
                  class={`cell c-${f.trust}${explainedIds.has(f.id) ? ' ex' : ''}`}
                  href={entryUrl(f)}
                  aria-label={`Entry ${f.id}, ${plain}, ${TRUST_LADDER.find((t) => t.key === f.trust)?.label}${explainedIds.has(f.id) ? ', explained' : ''}`}
                  data-id={f.id}
                  data-tip={`${plain}`}
                  data-trust={TRUST_LADDER.find((t) => t.key === f.trust)?.label}
                />
              </li>
            );
          })}
        </ul>
        <p class="fc-n">
          <span><b class="num">{items.length}</b> results</span>
          <span><b class="num">{formal}</b> with formal proof</span>
        </p>
      </li>
    );
  })}
</>
<script>
  if (matchMedia('(hover: hover)').matches) {
    const tip = document.createElement('div');
    tip.className = 'cell-tip';
    tip.setAttribute('aria-hidden', 'true');
    document.body.appendChild(tip);
    let cur: HTMLElement | null = null;
    const place = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const t = tip.getBoundingClientRect();
      let x = r.left + r.width / 2 - t.width / 2;
      x = Math.max(8, Math.min(x, innerWidth - t.width - 8));
      let y = r.top - t.height - 8;
      if (y < 8) y = r.bottom + 8;
      tip.style.left = `${x}px`;
      tip.style.top = `${y}px`;
    };
    document.addEventListener('pointerover', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.fcard .cell');
      if (!el) { if (cur) { tip.classList.remove('on'); cur = null; } return; }
      if (el === cur) return;
      cur = el;
      tip.innerHTML = '';
      const id = document.createElement('span');
      id.className = 'ct-id';
      id.textContent = `${el.dataset.id} · ${el.dataset.trust}`;
      tip.append(id, document.createTextNode(el.dataset.tip ?? ''));
      place(el);
      tip.classList.add('on');
    });
    addEventListener('scroll', () => { tip.classList.remove('on'); cur = null; }, { passive: true });
  }
</script>
