---
import type { Entry } from '../lib/entry.js';
import TrustLabel from './TrustLabel.astro';

interface Props {
  entry: Entry;
  trust: string;
  papers: number;
}
const { entry, trust, papers } = Astro.props;
---
<div class="score">
  <div>
    <div class="label">First step</div>
    <div class="v">{entry.scorecard.firstStep ?? '—'}</div>
    {entry.scorecard.firstStepBy && <div class="m">{entry.scorecard.firstStepBy}</div>}
  </div>
  <div>
    <div class="label">Significance</div>
    <div class="v">{entry.scorecard.significance}</div>
    <div class="m">{entry.scorecard.significanceWhy}</div>
  </div>
  <div>
    <div class="label">Trust</div>
    <div class="v"><TrustLabel trust={trust} /></div>
  </div>
  <div>
    <div class="label">Field</div>
    <div class="v">{entry.scorecard.field}</div>
    <div class="m">{papers} paper{papers === 1 ? '' : 's'}</div>
  </div>
</div>
