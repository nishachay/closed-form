---
interface Point {
  year: number;
  value: number;
  who: string;
  claim?: boolean;
  source: number;
}
interface Props {
  title: string;
  note?: string;
  points: Point[];
}
const { title, note, points } = Astro.props;
const max = Math.max(...points.map((p) => p.value));
const titled = title.split(/([\u0370-\u03ff]+)/g);
---
<figure class="fig">
  <figcaption class="label">{titled.map((run, i) => (i % 2 === 1 ? <span class="nc">{run}</span> : run))}</figcaption>
  <div class="bars" aria-hidden="true">
    {points.map((p) => (
      <div class={`bar-col${p.claim ? ' claim' : ''}`}>
        <div class="bar-track">
          <span class="bar" style={`block-size: ${(100 * p.value) / max}%`}>
            <span class="bar-val">{p.value}</span>
          </span>
        </div>
        <span class="bar-yr">{p.year}</span>
        <span class="bar-who">{p.who}</span>
      </div>
    ))}
  </div>
  <div class="sr">
    <table>
      <thead>
        <tr>
          <th>Year</th>
          <th>Who</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        {points.map((p) => (
          <tr>
            <td>{p.year}</td>
            <td>{p.who}</td>
            <td>{p.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="figcap">{note}</p>}
</figure>
