---
import type { Family } from '../lib/catalog.js';

interface Props {
  family: Family;
}
const { family: f } = Astro.props;
const leanHref = f.leanDoc
  ? f.leanDoc.startsWith('http')
    ? f.leanDoc
    : `https://github.com/openai/math/blob/main/${f.leanDoc}`
  : '';
---
<section aria-labelledby="the-original">
  <h2 id="the-original">The original</h2>
  <ul class="papers">
    {f.papers.map((p) => (
      <li>
        <a href={p.pdf} target="_blank" rel="noopener">{p.title}</a>
        <div class="d">
          {p.date ?? ''}{p.lean ? ' · formal proof listed' : ''}
        </div>
      </li>
    ))}
  </ul>
  <div class="links">
    {f.leanDoc && <a href={leanHref} target="_blank" rel="noopener">Lean notes ↗</a>}
    {f.trace && <a href={f.trace} target="_blank" rel="noopener">Model's reasoning summary ↗</a>}
  </div>
</section>
