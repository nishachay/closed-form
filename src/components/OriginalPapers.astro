---
import type { Family } from '../lib/catalog.js';

interface Props {
  family: Family;
}
const { family: f } = Astro.props;

function dateLabel(iso: string | null): string {
  return iso ?? 'date unknown';
}
---
<section aria-labelledby="the-original">
  <h2 id="the-original">The original</h2>
  <ul class="original">
    {f.papers.map((p) => (
      <li>
        <a href={p.pdf}>{p.title}</a>
        <span> · {dateLabel(p.date)}</span>
        {p.lean && <span class="lean-badge">Lean proof listed</span>}
      </li>
    ))}
  </ul>
  {f.leanDoc && (
    <p>
      <a href={`https://github.com/openai/math/blob/main/${f.leanDoc}`}>Lean notes for this family</a>
    </p>
  )}
  {f.trace && (
    <p>
      <a href={f.trace}>Published reasoning summary (PDF)</a>
    </p>
  )}
</section>
