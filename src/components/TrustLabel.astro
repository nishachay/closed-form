---
import { trustClass, trustLevel } from '../lib/trust.js';

interface Props {
  trust: string;
  /** Long ladder label (default) or compact short label. */
  short?: boolean;
}
const { trust, short = false } = Astro.props;
const level = trustLevel(trust);
---
<span class="trust"><i class={`dot c-${trustClass(trust)}`} aria-hidden="true"></i>{short ? level.short : level.label}</span>
