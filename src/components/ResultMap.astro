---
import type { Family } from '../lib/catalog.js';
import { appUrl, catalog } from '../lib/site.js';
import { entryUrl } from '../lib/site.js';
import { trustLevel } from '../lib/trust.js';
import { slugify } from '../lib/slug.js';

interface Props {
  families?: Family[];
  /** NNN ids with a published explainer. */
  explainedIds?: Set<string>;
}
const { families: list = catalog.families, explainedIds = new Set() } = Astro.props;

const order: Record<string, number> = { formal: 0, partial: 1, claimed: 2 };
const groups = catalog.subjects.map((subject) => ({
  subject,
  items: list
    .filter((f) => f.subject === subject)
    .sort((a, b) => (order[a.trust] ?? 9) - (order[b.trust] ?? 9) || a.id.localeCompare(b.id)),
}));
---
<div>
  {groups.map((g) => (
    <section class="map-field" aria-label={g.subject}>
      <h3 class="map-field-title">
        <a href={appUrl(`/archive/?field=${slugify(g.subject)}`)}>{g.subject}</a>
      </h3>
      <ul class="map-cells">
        {g.items.map((f) => {
          const explained = explainedIds.has(f.id);
          const plainTitle = f.title.replace(/<[^>]+>/g, '');
          const label = `Entry ${f.id}, ${plainTitle}, ${trustLevel(f.trust).label}${explained ? ', explained' : ''}`;
          return (
            <li>
              <a
                class={`map-cell map-cell-${f.trust}${explained ? ' map-cell-explained' : ''}`}
                href={entryUrl(f)}
                aria-label={label}
                title={`${f.id} · ${plainTitle} · ${trustLevel(f.trust).label}`}
              />
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>
