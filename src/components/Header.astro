---
import { appUrl } from '../lib/site.js';

interface Props {
  current?: 'home' | 'archive' | 'about';
}
const { current } = Astro.props;
const github = 'https://github.com/nishachay/closed-form';
---
<header class="top">
  <div class="wrap top-in">
    <a class="logo" href={appUrl('/')} aria-label="Closed Form, home">
      <i aria-hidden="true"></i>Closed Form
    </a>
    <nav class="top-nav" aria-label="Primary">
      <a href={appUrl('/archive/')} aria-current={current === 'archive' ? 'page' : undefined}>Archive</a>
      <a href={appUrl('/about/')} aria-current={current === 'about' ? 'page' : undefined}>About</a>
    </nav>
    <div class="top-r">
      {current !== 'archive' && current !== 'home' && (
        <a class="top-search" href={appUrl('/archive/#q')} aria-label="Search the archive">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <span class="ts-t">Search results</span>
          <kbd aria-hidden="true">/</kbd>
        </a>
      )}
      <a class="top-gh" href={github} target="_blank" rel="noopener" aria-label="Closed Form on GitHub (opens in a new tab)">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
      </a>
    </div>
  </div>
</header>
<script>
  // "/" anywhere outside a text field jumps to archive search (archive page has its own handler).
  if (!document.getElementById('q')) {
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable]')) return;
      const hero = document.getElementById('hq') as HTMLInputElement | null;
      if (hero) { e.preventDefault(); hero.focus(); hero.select(); return; }
      const link = document.querySelector<HTMLAnchorElement>('.top-search');
      if (link) { e.preventDefault(); location.href = link.href; }
    });
  }
</script>
