---
interface Term {
  term: string;
  meaning: string;
}
interface Props {
  items: Term[];
}
const { items } = Astro.props;
---
<section aria-labelledby="words-used">
  <h2 id="words-used">Words used</h2>
  <dl class="gl">
    {items.map((g) => (
      <>
        <dt>{g.term}</dt>
        <dd>{g.meaning}</dd>
      </>
    ))}
  </dl>
</section>
