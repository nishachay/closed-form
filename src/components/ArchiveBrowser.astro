---
import type { Family } from '../lib/catalog.js';
import { catalog, loadExplainedIds } from '../lib/site.js';
import ArchiveRow from './ArchiveRow.astro';
import { TRUST_LADDER } from '../lib/trust.js';
import { slugify } from '../lib/slug.js';

interface Props {
  families: Family[];
  /** Fix the field filter (field pages): hides the Field group. */
  lockField?: string;
}
const { families: list, lockField } = Astro.props;

const explainedIds = await loadExplainedIds();

const groups = catalog.subjects
  .map((subject) => ({ subject, items: list.filter((f) => f.subject === subject) }))
  .filter((g) => g.items.length > 0);

const trustCounts = Object.fromEntries(TRUST_LADDER.map((t) => [t.key, list.filter((f) => f.trust === t.key).length]));
const explainedCount = list.filter((f) => explainedIds.has(f.id)).length;
---
<div class="wrap arch">
  <aside class="filters" aria-label="Filters">
    <div class="fgroup">
      <h2 class="fg-h">Trust</h2>
      <div class="fopts" id="seg" role="group" aria-label="Filter by trust">
        <button type="button" class="seg-b fopt" data-v="all" aria-pressed="true">
          <span class="fo-l">All results</span><span class="c">{list.length}</span>
        </button>
        {TRUST_LADDER.map((t) => (
          <button type="button" class="seg-b fopt" data-v={t.key} aria-pressed="false">
            <span class="fo-l"><i class={`dot c-${t.key}`} aria-hidden="true"></i>{t.label}</span>
            <span class="c">{trustCounts[t.key] ?? 0}</span>
          </button>
        ))}
        <button type="button" class="seg-b fopt" data-v="explained" aria-pressed="false">
          <span class="fo-l"><i class="dot dot-ex" aria-hidden="true"></i>Explained</span>
          <span class="c">{explainedCount}</span>
        </button>
      </div>
    </div>
    {!lockField && (
      <div class="fgroup">
        <h2 class="fg-h">Field</h2>
        <div class="fopts" id="chips" role="group" aria-label="Filter by field">
          <button type="button" class="chip fopt" data-v="All" aria-pressed="true" title="All fields">
            <span class="fo-l">All fields</span><span class="c">{list.length}</span>
          </button>
          {catalog.subjects.map((s) => {
            const n = list.filter((f) => f.subject === s).length;
            return n > 0 ? (
              <button type="button" class="chip fopt" data-v={s} aria-pressed="false" title={s}>
                <span class="fo-l">{s}</span><span class="c">{n}</span>
              </button>
            ) : null;
          })}
        </div>
      </div>
    )}
  </aside>
  <div class="arch-main">
    <div class="tools" role="search">
      <div class="sbox">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <label for="q" class="sr">Search results</label>
        <input
          id="q"
          class="search"
          name="q"
          type="search"
          autocomplete="off"
          spellcheck={false}
          enterkeyhint="search"
          placeholder="Search titles and claims"
        />
        <kbd class="kbd" aria-hidden="true">/</kbd>
      </div>
      <div class="toolbar">
        <p class="count" id="count" role="status"><b>{list.length}</b> results</p>
        <div class="tb-r">
          <button class="reset" type="button" id="reset" hidden>Clear filters</button>
          <div class="selbox sort">
            <label for="sort" class="sr">Sort</label>
            <select id="sort" class="select select-sm">
              <option value="cat">By field</option>
              <option value="new">Newest first</option>
              <option value="trust">Most trusted first</option>
            </select>
            <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
          </div>
        </div>
      </div>
    </div>

    <div class="list" id="list" data-lockfield={lockField ?? ''}>
      <div id="groups">
        {groups.map((g) => (
          <section class="group" data-group={slugify(g.subject)} aria-label={g.subject}>
            <h3 class="group-h" id={`g-${g.items[0].id}`}>
              <span>{g.subject}</span><span class="num">{g.items.length}</span>
            </h3>
            <ul class="rlist">
              {g.items.map((f) => (
                <ArchiveRow family={f} explained={explainedIds.has(f.id)} />
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>
</div>

<script src="../scripts/archive-filter.ts"></script>
