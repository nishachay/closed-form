---
import { appUrl, computeStats, catalog } from '../lib/site.js';
const stats = computeStats();
const year = new Date().getFullYear();
const short = catalog.source.commit.slice(0, 7);
const built = new Date(catalog.source.fetchedAt);
const builtLabel = isNaN(built.getTime())
  ? ''
  : built.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const me = {
  x: 'https://x.com/ni5hachay',
  gh: 'https://github.com/nishachay',
  repo: 'https://github.com/nishachay/closed-form',
};
---
<footer class="site-footer">
  <div class="wrap ft">
    <div class="ft-brand">
      <a class="logo" href={appUrl('/')} aria-label="Closed Form, home"><i aria-hidden="true"></i>Closed Form</a>
      <p class="ft-tag">Every problem AI has solved, explained for everyone.</p>
    </div>

    <nav class="ft-cols" aria-label="Footer">
      <div class="ft-col">
        <h2 class="label">Explore</h2>
        <ul>
          <li><a href={appUrl('/archive/')}>Archive</a></li>
          <li><a href={appUrl('/about/')}>About and trust labels</a></li>
          <li><a href={appUrl('/data/fields.json')}>Data (JSON)</a></li>
        </ul>
      </div>
      <div class="ft-col">
        <h2 class="label">Source</h2>
        <ul>
          <li><a href="https://github.com/openai/math" target="_blank" rel="noopener">openai/math <span aria-hidden="true">↗</span></a></li>
          <li><a href={`https://github.com/openai/math/commit/${catalog.source.commit}`} target="_blank" rel="noopener"><span class="num">{short}</span>{builtLabel && ` · ${builtLabel}`} <span aria-hidden="true">↗</span></a></li>
          <li><a href={me.repo} target="_blank" rel="noopener">This site's code <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </nav>

    <div class="ft-made">
      <p class="ft-by">
        Made with <span class="ft-heart" aria-label="love" role="img">♥</span> by
        <a href={me.x} target="_blank" rel="noopener me">Nishachay</a>
      </p>
      <div class="ft-social">
        <a href={me.x} target="_blank" rel="noopener me" aria-label="Nishachay on X (opens in a new tab)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href={me.gh} target="_blank" rel="noopener me" aria-label="Nishachay on GitHub (opens in a new tab)">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        </a>
      </div>
    </div>

    <p class="ft-legal">
      Papers by OpenAI, shared under Apache-2.0. Closed Form is independent and not affiliated with OpenAI.
      <span class="num">{stats.results}</span> results, <span class="num">{stats.papers}</span> papers. © {year}
    </p>
  </div>
</footer>
